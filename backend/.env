# Application Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ScoutLab API"
API_V1_STR=/api/v1
SECRET_KEY=scoutlab-super-secret-key-change-in-production-minimum-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","https://lovable.dev"]

# Database (PostgreSQL / SQLite fallback for offline dev/tests)
POSTGRES_USER=scoutlab
POSTGRES_PASSWORD=scoutlab_secret
POSTGRES_DB=scoutlab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=sqlite+aiosqlite:///./scoutlab.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Demo / Offline Mode
