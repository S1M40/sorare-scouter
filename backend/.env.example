# Application Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="ScoutLab API"
API_V1_STR=/api/v1
SECRET_KEY=scoutlab-super-secret-key-change-in-production-minimum-32-chars-long
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080","https://lovable.dev"]

# Database (PostgreSQL / SQLite fallback for offline dev/tests)
POSTGRES_USER=scoutlab
POSTGRES_PASSWORD=scoutlab_secret
POSTGRES_DB=scoutlab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://scoutlab:scoutlab_secret@localhost:5432/scoutlab

# Redis
REDIS_URL=redis://localhost:6379/0

# Demo / Offline Mode
# Set to true to populate realistic football intelligence and mock data without Sorare credentials
DEMO_MODE=true

# Sorare Integration Credentials
SORARE_GRAPHQL_URL=https://api.sorare.com/federation/graphql
SORARE_WS_URL=wss://ws.sorare.com/cable
SORARE_API_KEY=19104f2703db43f0c4f962eac0e35e156f93da1b5d32df414243f50f919da68059047052cd12e3a13df7907e8171fcae4e7320c673f979e8aa88e714834sr128
SORARE_JWT=

# Analytics Engine Weights (Normalized to sum to 1.0)
FORM_WEIGHT=0.25
CONSISTENCY_WEIGHT=0.15
MINUTES_WEIGHT=0.15
FIXTURE_WEIGHT=0.15
AVAILABILITY_WEIGHT=0.15
MARKET_WEIGHT=0.15

# Background Workers & Synchronization
SYNC_INTERVAL_MINUTES=30
